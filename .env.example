# =============================================================================
# Swap Aggregator — variables de entorno
# Copia este archivo a .env y ajusta los valores.
# .env NUNCA se commitea (está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# RPC endpoints por chain id.
# Solo las chains con URL configurada se habilitan en runtime.
# Deja vacía una URL para deshabilitar esa chain.
# -----------------------------------------------------------------------------

# Ethereum mainnet
RPC_URL_1=https://eth.llamarpc.com

# BNB Smart Chain
RPC_URL_56=https://bsc-dataseed.binance.org

# Polygon
RPC_URL_137=https://polygon-rpc.com

# Arbitrum One (opcional — añade el Chain en config/chains.py para activarla)
# RPC_URL_42161=https://arb1.arbitrum.io/rpc

# Optimism (opcional — añade el Chain en config/chains.py para activarla)
# RPC_URL_10=https://mainnet.optimism.io

# Sepolia testnet (para swaps de prueba)
RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com

# -----------------------------------------------------------------------------
# Defaults de swap
# -----------------------------------------------------------------------------

# Slippage máximo permitido (basis points; 1 bps = 0.01%)
# 1000 bps = 10%
MAX_SLIPPAGE_BPS=1000

# Deadline por defecto de una tx de swap (segundos)
DEFAULT_DEADLINE_SECONDS=1200

# TTL de una quote antes de considerarla expirada (segundos)
DEFAULT_QUOTE_TTL_SECONDS=30

# -----------------------------------------------------------------------------
# API (FastAPI / uvicorn)
# -----------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000

# dev | prod | test
ENVIRONMENT=dev

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Orígenes CORS permitidos. En dev: * (permite todo).
# En prod: "https://miapp.com,https://www.miapp.com"
CORS_ALLOW_ORIGINS=*

# -----------------------------------------------------------------------------
# Integración futura con auth de wallet (SIWE)
# -----------------------------------------------------------------------------

# Secreto para firmar sesiones SIWE. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SIWE_SECRET=changeme_replace_me
